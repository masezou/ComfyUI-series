# syntax=docker/dockerfile:1.7

# ------------------------------------------------------------------
# ComfyUI for Strix Halo / gfx1151 using TheRock ROCm 7.13 wheels
#
# Target:
# - Ryzen AI MAX+ 395 / Radeon 8060S / gfx1151
# - ROCm 7.13 test image
# - ComfyUI runtime with env-driven startup args
# - Startup custom_nodes requirements installer inherited from 7.2.3 image
#
# Notes:
# - This is a test image, not a production-stable ROCm 7.2.3 replacement.
# - SageAttention is intentionally not installed by default for ROCm.
# - NVIDIA/CUDA/TensorRT-related custom node dependencies are filtered out.
# ------------------------------------------------------------------

FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive
ARG COMFY_REF=master
ARG COMFY_COMMIT=
ARG COMFY_CACHEBUST=0

# TheRock gfx1151 wheel index.
# Override this if AMD changes the endpoint.
ARG THEROCK_INDEX_URL="https://d2awnip2yjpvqn.cloudfront.net/v2/gfx1151/"

ENV VENV=/opt/venv \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git git-lfs \
      python3 python3-venv python3-full python3-pip python3-dev \
      ffmpeg \
      libgl1 libglib2.0-0 libgomp1 libnuma1 \
      pciutils kmod procps \
      build-essential pkg-config \
    && git lfs install --system \
    && rm -rf /var/lib/apt/lists/*

RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    python3 -m venv ${VENV} \
 && ${VENV}/bin/python -m ensurepip --upgrade \
 && ${VENV}/bin/python -m pip install -U pip setuptools wheel \
 && ${VENV}/bin/python -m pip install -U GitPython uv

# Install ROCm runtime/libraries and PyTorch stack for gfx1151 from TheRock.
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    ${VENV}/bin/python -m pip install \
      --index-url "${THEROCK_INDEX_URL}" \
      "rocm[libraries,devel]" \
 && ${VENV}/bin/python -m pip install \
      --index-url "${THEROCK_INDEX_URL}" \
      torch torchvision torchaudio pytorch-triton-rocm numpy

# Verify ROCm PyTorch stack.
RUN ${VENV}/bin/python - <<'PY'
import torch
print("torch =", torch.__version__)
print("torch.version.hip =", getattr(torch.version, "hip", None))
print("cuda.is_available =", torch.cuda.is_available())
if torch.cuda.is_available():
    print("device =", torch.cuda.get_device_name(0))
PY

RUN echo "COMFY_CACHEBUST=${COMFY_CACHEBUST}" \
 && echo "COMFY_REF=${COMFY_REF}" \
 && echo "COMFY_COMMIT=${COMFY_COMMIT}" \
 && git clone --filter=blob:none https://github.com/comfyanonymous/ComfyUI.git /opt/ComfyUI \
 && cd /opt/ComfyUI \
 && if [ -n "${COMFY_COMMIT}" ]; then \
      git fetch --depth 1 origin "${COMFY_COMMIT}" && git checkout --detach "${COMFY_COMMIT}"; \
    else \
      git checkout "${COMFY_REF}"; \
    fi \
 && rm -rf /opt/ComfyUI/.git

# Install ComfyUI dependencies except torch/torchvision/torchaudio and GPU-vendor-conflicting packages.
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    bash -lc ' \
      awk '"'"'NF > 0 && \
      $0 !~ /^[[:space:]]*#/ && \
      $0 !~ /^(torch|torchvision|torchaudio)([<>=!~ ].*)?$/ && \
      tolower($0) !~ /(nvidia|cuda|cudnn|tensorrt|vfx|amido)/ \
      {print}'"'"' /opt/ComfyUI/requirements.txt > /tmp/requirements.no_torch.txt \
      && if [ -s /tmp/requirements.no_torch.txt ]; then \
           ${VENV}/bin/python -m pip install -U -r /tmp/requirements.no_torch.txt; \
         else \
           echo "[build] no installable deps after filtering"; \
         fi \
    ' \
 && rm -f /tmp/requirements.no_torch.txt \
 && rm -rf /tmp/*

WORKDIR /opt/ComfyUI
EXPOSE 8188

# Strix Halo / gfx1151 specific defaults.
ENV PATH="/opt/venv/bin:${PATH}" \
    VIRTUAL_ENV=/opt/venv \
    PYTHONUNBUFFERED=1 \
    COMFY_LISTEN=0.0.0.0 \
    COMFY_PORT=8188 \
    COMFY_ARGS="--force-fp16 --preview-method auto" \
    PYTORCH_ALLOC_CONF=expandable_segments:True \
    PYTORCH_HIP_ALLOC_CONF=expandable_segments:True \
    PYTORCH_SDP_DISABLE_FLASH=0 \
    PYTORCH_SDP_DISABLE_MEM_EFFICIENT=0 \
    PYTORCH_SDP_DISABLE_MATH=0 \
    XFORMERS_FORCE_DISABLE_TRITON=1 \
    TORCHDYNAMO_DISABLE=1 \
    TORCHINDUCTOR_DISABLE=1 \
    TRITON_CACHE_DIR=/opt/venv/.cache/triton

CMD ["/bin/sh", "-lc", "\
mkdir -p /opt/ComfyUI/.startup-state /opt/venv/.cache/triton && \
/opt/venv/bin/python - <<'PY'\n\
import os, torch\n\
print('torch=', torch.__version__)\n\
print('hip=', getattr(torch.version, 'hip', None))\n\
print('cuda.is_available=', torch.cuda.is_available())\n\
print('HIP_VISIBLE_DEVICES=', os.environ.get('HIP_VISIBLE_DEVICES'))\n\
print('ROCR_VISIBLE_DEVICES=', os.environ.get('ROCR_VISIBLE_DEVICES'))\n\
print('HSA_OVERRIDE_GFX_VERSION=', os.environ.get('HSA_OVERRIDE_GFX_VERSION'))\n\
if getattr(torch.version, 'hip', None) is not None and torch.cuda.is_available():\n\
  print('device=', torch.cuda.get_device_name(0))\n\
PY\n\
echo '[startup] scanning custom_nodes requirements...'\n\
find /opt/ComfyUI/custom_nodes -type f -name requirements.txt 2>/dev/null | while read -r req; do\n\
  node_dir=\"$(dirname \"$req\")\"\n\
  node_name=\"$(basename \"$node_dir\")\"\n\
  filtered=\"/tmp/${node_name}.requirements.filtered.txt\"\n\
  hash_file=\"/opt/ComfyUI/.startup-state/${node_name}.requirements.sha256\"\n\
  current_hash=\"$(sha256sum \"$req\" | awk '{print $1}')\"\n\
  old_hash=''\n\
  if [ -f \"$hash_file\" ]; then old_hash=\"$(cat \"$hash_file\" 2>/dev/null)\"; fi\n\
  echo \"[startup] found: $req\"\n\
  if echo \"$node_name\" | grep -qiE 'nvidia|cuda|cudnn|tensorrt|vfx|amido'; then\n\
    echo \"[startup] skip GPU-specific node: $node_name\"\n\
    echo \"$current_hash\" > \"$hash_file\"\n\
    continue\n\
  fi\n\
  awk 'NF > 0 && $0 !~ /^[[:space:]]*#/ && $0 !~ /^(torch|torchvision|torchaudio)([<>=!~ ].*)?$/ && tolower($0) !~ /(nvidia|cuda|cudnn|tensorrt|vfx|amido)/ {print}' \"$req\" > \"$filtered\"\n\
  if [ ! -s \"$filtered\" ]; then\n\
    echo \"[startup] no installable deps after filtering for $node_name\"\n\
    echo \"$current_hash\" > \"$hash_file\"\n\
    rm -f \"$filtered\"\n\
    continue\n\
  fi\n\
  if [ \"$current_hash\" = \"$old_hash\" ]; then\n\
    echo \"[startup] unchanged, skip install for $node_name\"\n\
    rm -f \"$filtered\"\n\
    continue\n\
  fi\n\
  echo \"[startup] changed, installing deps for $node_name\"\n\
  /opt/venv/bin/python -m pip install --no-cache-dir --disable-pip-version-check -U -r \"$filtered\" && echo \"$current_hash\" > \"$hash_file\"\n\
  rc=$?\n\
  rm -f \"$filtered\"\n\
  if [ $rc -ne 0 ]; then\n\
    echo \"[startup] pip install failed for $node_name\"\n\
    exit $rc\n\
  fi\n\
done\n\
/opt/venv/bin/python - <<'PY'\n\
import os, shlex\n\
listen = os.environ.get('COMFY_LISTEN', '0.0.0.0')\n\
port   = os.environ.get('COMFY_PORT', '8188')\n\
extra  = os.environ.get('COMFY_ARGS', '')\n\
extra_args = shlex.split(extra) if extra.strip() else []\n\
argv = ['/opt/venv/bin/python', 'main.py', '--listen', listen, '--port', str(port), *extra_args]\n\
print('[comfy] argv:', ' '.join(shlex.quote(a) for a in argv[2:]))\n\
os.chdir('/opt/ComfyUI')\n\
os.execv(argv[0], argv)\n\
PY\n\
"]
