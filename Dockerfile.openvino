# syntax=docker/dockerfile:1.7
# ------------------------------------------------------------------
# ComfyUI Intel iGPU image (Ubuntu 24.04 / amd64) - OpenVINO-oriented
#
# Revised for:
# - cache mounts on apt/pip heavy steps
# - COMFY_COMMIT support while keeping COMFY_CACHEBUST
# - split ComfyUI checkout / requirements install for better cache reuse
# - safer cleanup when cache mounts are in use
# ------------------------------------------------------------------

# ================================================================
# Stage: base
# Purpose:
# - Start from Ubuntu 24.04
# - Validate target architecture (amd64 only)
# - Install common OS packages, Python, Git LFS, FFmpeg, OpenCL/Level Zero
# - Install Intel GPU runtime packages for OpenCL / Level Zero
# - Register Intel OpenCL ICD and refresh linker cache
# Notes:
# - This stage is shared by both builder and runtime to avoid duplication
# ================================================================
FROM ubuntu:24.04 AS base

ARG TARGETPLATFORM
ARG TARGETARCH
ARG DEBIAN_FRONTEND=noninteractive
ARG IGC_TAG=v2.30.1
ARG IGC_VER=2.30.1+20950
ARG COMPUTE_VER=26.09.37435.1
ARG GMMLIB_VER=22.9.0

# Python and virtualenv defaults used in later stages
ENV PIP_NO_CACHE_DIR=1
ENV PYTHONUNBUFFERED=1
ENV VENV=/opt/venv

# Install base OS dependencies and fail early on non-amd64 builds
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    echo "[build] (base) TARGETPLATFORM=${TARGETPLATFORM} TARGETARCH=${TARGETARCH}" \
 && if [ "${TARGETARCH}" != "amd64" ]; then \
      echo "This Dockerfile currently supports amd64 only."; \
      exit 1; \
    fi \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      wget \
      git \
      git-lfs \
      ffmpeg \
      build-essential \
      pkg-config \
      python3 \
      python3-venv \
      python3-pip \
      libgl1 \
      libglib2.0-0 \
      libgomp1 \
      libstdc++6 \
      libtbb12 \
      libnuma1 \
      libdrm2 \
      libdrm-intel1 \
      libze1 \
      clinfo \
      ocl-icd-libopencl1 \
 && git lfs install --system \
 && rm -rf /var/lib/apt/lists/*

# Install Intel GPU userspace runtime components from upstream release artifacts
RUN set -eux; \
    mkdir -p /tmp/intel; \
    cd /tmp/intel; \
    wget -S -O intel-igc-core.deb "https://github.com/intel/intel-graphics-compiler/releases/download/${IGC_TAG}/intel-igc-core-2_${IGC_VER}_amd64.deb"; \
    wget -S -O intel-igc-opencl.deb "https://github.com/intel/intel-graphics-compiler/releases/download/${IGC_TAG}/intel-igc-opencl-2_${IGC_VER}_amd64.deb"; \
    wget -S -O intel-ocloc.deb "https://github.com/intel/compute-runtime/releases/download/${COMPUTE_VER}/intel-ocloc_${COMPUTE_VER}-0_amd64.deb"; \
    wget -S -O intel-opencl-icd.deb "https://github.com/intel/compute-runtime/releases/download/${COMPUTE_VER}/intel-opencl-icd_${COMPUTE_VER}-0_amd64.deb"; \
    wget -S -O libigdgmm12.deb "https://github.com/intel/compute-runtime/releases/download/${COMPUTE_VER}/libigdgmm12_${GMMLIB_VER}_amd64.deb"; \
    wget -S -O libze-intel-gpu1.deb "https://github.com/intel/compute-runtime/releases/download/${COMPUTE_VER}/libze-intel-gpu1_${COMPUTE_VER}-0_amd64.deb"; \
    dpkg -i \
      ./intel-igc-core.deb \
      ./intel-igc-opencl.deb \
      ./intel-ocloc.deb \
      ./intel-opencl-icd.deb \
      ./libigdgmm12.deb \
      ./libze-intel-gpu1.deb \
    || apt-get update && apt-get -fy install; \
    rm -rf /tmp/intel /var/lib/apt/lists/*

# Register Intel OpenCL ICD loader entry and shared library path
RUN mkdir -p /etc/OpenCL/vendors \
 && printf '%s\n' '/usr/lib/x86_64-linux-gnu/intel-opencl/libigdrcl.so' > /etc/OpenCL/vendors/intel.icd \
 && printf '%s\n' '/usr/lib/x86_64-linux-gnu/intel-opencl' > /etc/ld.so.conf.d/intel-opencl.conf \
 && ldconfig

# ================================================================
# Stage: builder
# Purpose:
# - Create an isolated Python virtualenv
# - Clone ComfyUI at a branch/tag or pinned commit
# - Install ComfyUI Python dependencies
# - Replace any accelerator-specific PyTorch with CPU-only wheels
#   for core ComfyUI stability in this image
# - Install OpenVINO packages and the comfyui_openvino custom node
# - Clean bytecode/caches before handing artifacts to runtime
# ================================================================
FROM base AS builder

ARG COMFY_REF=master
ARG COMFY_COMMIT=
ARG COMFY_CACHEBUST=0

# Create the application virtual environment and install build helpers
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    python3 -m venv ${VENV} \
 && ${VENV}/bin/python -m pip install -U pip setuptools wheel \
 && ${VENV}/bin/python -m pip install -U GitPython uv \
 && rm -rf /tmp/pip-* /tmp/tmp*

# Clone ComfyUI source and optionally pin to a specific commit
RUN echo "COMFY_CACHEBUST=${COMFY_CACHEBUST}" \
 && echo "COMFY_REF=${COMFY_REF}" \
 && echo "COMFY_COMMIT=${COMFY_COMMIT}" \
 && git clone --filter=blob:none https://github.com/comfyanonymous/ComfyUI.git /opt/ComfyUI \
 && cd /opt/ComfyUI \
 && if [ -n "${COMFY_COMMIT}" ]; then \
      git fetch --depth 1 origin "${COMFY_COMMIT}" \
   && git checkout --detach "${COMFY_COMMIT}"; \
    else \
      git checkout "${COMFY_REF}"; \
    fi

# Install ComfyUI requirements into the virtual environment
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    cd /opt/ComfyUI \
 && ${VENV}/bin/python -m pip install -U -r requirements.txt \
 && rm -rf /tmp/pip-* /tmp/tmp*

# ------------------------------------------------------------------
# Force CPU-only PyTorch for ComfyUI core stability
# - Remove any CUDA/XPU builds that may have been pulled transitively
# - Reinstall CPU wheels explicitly
# ------------------------------------------------------------------
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    ${VENV}/bin/python -m pip uninstall -y torch torchvision torchaudio || true \
 && ${VENV}/bin/python -m pip install \
      --index-url https://download.pytorch.org/whl/cpu \
      torch torchvision torchaudio \
 && ${VENV}/bin/python -c "import torch; print('torch=', torch.__version__); print('cuda=', getattr(torch.version, 'cuda', None)); print('cuda.is_available=', torch.cuda.is_available())" \
 && rm -rf /tmp/pip-* /tmp/tmp*

# Install OpenVINO runtime/tooling used by the OpenVINO custom node path
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    ${VENV}/bin/python -m pip install -U \
      openvino \
      openvino-tokenizers \
      openvino-genai \
 && rm -rf /tmp/pip-* /tmp/tmp*

WORKDIR /opt/ComfyUI/custom_nodes

# Add the OpenVINO custom node and install only its non-PyTorch requirements
RUN git clone https://github.com/openvino-dev-samples/comfyui_openvino.git \
 && cd comfyui_openvino \
 && if [ -f requirements.txt ]; then \
      awk 'NF > 0 && $0 !~ /^[[:space:]]*#/ && $0 !~ /^(torch|torchvision|torchaudio)([<>=!~ ].*)?$/ {print}' requirements.txt > /tmp/comfyui_openvino.requirements.filtered.txt; \
      if [ -s /tmp/comfyui_openvino.requirements.filtered.txt ]; then ${VENV}/bin/python -m pip install -U -r /tmp/comfyui_openvino.requirements.filtered.txt; fi; \
      rm -f /tmp/comfyui_openvino.requirements.filtered.txt; \
    fi \
 && rm -rf /root/.cache /tmp/pip-* /tmp/tmp*

# Remove Python bytecode/caches to keep the copied runtime tree cleaner
RUN find ${VENV} -type d -name "__pycache__" -prune -exec rm -rf {} + \
 && find ${VENV} -type f -name "*.pyc" -delete

# ================================================================
# Stage: runtime
# Purpose:
# - Assemble the final runnable image from base + built artifacts
# - Define OpenVINO / CPU execution defaults
# - Generate helper scripts for diagnostics and startup
# - On container start, print Intel/OpenCL diagnostics, lazily install
#   custom node requirements, then exec ComfyUI
# ================================================================
FROM base AS runtime

# Runtime environment for ComfyUI, OpenVINO, and startup behavior
ENV PATH="/opt/venv/bin:${PATH}" \
    VIRTUAL_ENV=/opt/venv \
    PYTHONUNBUFFERED=1 \
    TRITON_CACHE_DIR=/opt/venv/.cache/triton \
    COMFY_LISTEN=0.0.0.0 \
    COMFY_PORT=8188 \
    COMFY_ARGS="--cpu" \
    OMP_NUM_THREADS=8 \
    MKL_NUM_THREADS=8 \
    OPENVINO_LOG_LEVEL=0 \
    OPENVINO_TORCH_BACKEND_DEVICE=GPU \
    SYCL_CACHE_PERSISTENT=1 \
    SYCL_PI_LEVEL_ZERO_USE_IMMEDIATE_COMMANDLISTS=1 \
    ONEAPI_DEVICE_SELECTOR=level_zero:gpu \
    XFORMERS_FORCE_DISABLE_TRITON=1 \
    TORCHDYNAMO_DISABLE=1 \
    TORCHINDUCTOR_DISABLE=1

# Copy the prepared Python environment and ComfyUI tree from builder
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /opt/ComfyUI /opt/ComfyUI

WORKDIR /opt/ComfyUI
EXPOSE 8188

# Create a small Python diagnostic utility to print torch/OpenVINO status
RUN python3 - <<'PY'
from pathlib import Path
Path('/usr/local/bin/check_openvino.py').write_text(
'''import torch
print("torch=", torch.__version__)
print("cuda=", getattr(torch.version, "cuda", None))
print("cuda.is_available=", torch.cuda.is_available())
try:
    import openvino as ov
    core = ov.Core()
    print("openvino.available_devices=", core.available_devices)
except Exception as e:
    print("openvino check failed=", e)
'''
)
PY

# Create the Python launcher that normalizes env vars into ComfyUI argv
RUN python3 - <<'PY'
from pathlib import Path
Path('/usr/local/bin/launch_comfyui.py').write_text(
'''import os
import shlex

listen = os.environ.get("COMFY_LISTEN", "0.0.0.0")
port = os.environ.get("COMFY_PORT", "8188")
extra = os.environ.get("COMFY_ARGS", "--cpu")
extra_args = shlex.split(extra) if extra.strip() else []
argv = ["/opt/venv/bin/python", "main.py", "--listen", listen, "--port", str(port), *extra_args]
print("[comfy] argv:", " ".join(shlex.quote(a) for a in argv[2:]))
os.chdir("/opt/ComfyUI")
os.execv(argv[0], argv)
'''
)
PY

# Create the shell entrypoint wrapper:
# - emit Intel/OpenCL diagnostics
# - detect custom node requirements.txt files
# - install only when the hash changed
# - finally launch ComfyUI
RUN python3 - <<'PY'
from pathlib import Path
Path('/usr/local/bin/run_comfyui.sh').write_text(
'''#!/usr/bin/env bash
set -u

mkdir -p /opt/ComfyUI/.startup-state

echo '[startup] Intel/OpenVINO diagnostics'
ls -l /dev/dri 2>/dev/null || true

echo '[startup] OpenCL vendors'
ls -l /etc/OpenCL/vendors 2>/dev/null || true
for f in /etc/OpenCL/vendors/*.icd; do
  [ -e "$f" ] || continue
  echo "--- $f ---"
  cat "$f" || true
done

echo '[startup] ldconfig intel/opencl'
ldconfig -p | grep -Ei 'igdrcl|ze_intel|ze_loader|opencl|igc' || true

echo '[startup] clinfo'
clinfo 2>/dev/null | sed -n '1,120p' || true

/opt/venv/bin/python /usr/local/bin/check_openvino.py

echo '[startup] scanning custom_nodes requirements...'
find /opt/ComfyUI/custom_nodes -type f -name requirements.txt 2>/dev/null | while read -r req; do
  node_dir="$(dirname "$req")"
  node_name="$(basename "$node_dir")"
  filtered="/tmp/${node_name}.requirements.filtered.txt"
  hash_file="/opt/ComfyUI/.startup-state/${node_name}.requirements.sha256"
  current_hash="$(sha256sum "$req" | awk '{print $1}')"
  old_hash=""

  if [ -f "$hash_file" ]; then
    old_hash="$(cat "$hash_file" 2>/dev/null)"
  fi

  echo "[startup] found: $req"
  awk 'NF > 0 && $0 !~ /^[[:space:]]*#/ && $0 !~ /^(torch|torchvision|torchaudio)([<>=!~ ].*)?$/ {print}' "$req" > "$filtered"

  if [ ! -s "$filtered" ]; then
    echo "[startup] no installable deps after filtering for $node_name"
    echo "$current_hash" > "$hash_file"
    rm -f "$filtered"
    continue
  fi

  if [ "$current_hash" = "$old_hash" ]; then
    echo "[startup] unchanged, skip install for $node_name"
    rm -f "$filtered"
    continue
  fi

  echo "[startup] changed, installing deps for $node_name"
  /opt/venv/bin/python -m pip install --no-cache-dir --disable-pip-version-check -U -r "$filtered" && echo "$current_hash" > "$hash_file"
  rc=$?
  rm -f "$filtered"
  if [ $rc -ne 0 ]; then
    echo "[startup] pip install failed for $node_name"
    exit $rc
  fi
done

exec /opt/venv/bin/python /usr/local/bin/launch_comfyui.py
'''
)
PY

# Make the generated entrypoint wrapper executable
RUN chmod +x /usr/local/bin/run_comfyui.sh

# Default container start command
CMD ["/usr/local/bin/run_comfyui.sh"]
