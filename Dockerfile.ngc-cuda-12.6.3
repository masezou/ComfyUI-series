# syntax=docker/dockerfile:1.7
# ------------------------------------------------------------------
# ComfyUI on NVIDIA CUDA base image (NGC)
#
# Goals:
# - Use NVIDIA NGC CUDA image
# - Install explicit PyTorch CUDA wheels (torch/torchvision/torchaudio)
# - Avoid optional CUDA extensions (xformers/flash-attn/triton builds)
# - Install ComfyUI and its dependencies
# - Build comfy-aimdo from source so aimdo.so is present in the image
# - Keep git available in the runtime image for ComfyUI-Manager / GitPython
#
# Notes:
# - This variant uses explicit NGC CUDA base images instead of Docker Hub nvidia/cuda.
# - Builder image : nvcr.io/nvidia/cuda:12.6.3-cudnn-devel-ubuntu24.04
# - Runtime image : nvcr.io/nvidia/cuda:12.6.3-runtime-ubuntu24.04
# - Default PyTorch wheel channel: cu126
# - For CUDA 12.9.x / 13.x, PyTorch wheel channels may not map 1:1 to the container CUDA
#   version. This file defaults to the selected PyTorch wheel channel intentionally.
# - COMFY_COMMIT can be passed to pin an exact upstream ComfyUI revision.
# - COMFY_CACHEBUST is kept as an emergency/manual layer invalidation knob.
# ------------------------------------------------------------------

ARG BUILDER_IMAGE=nvcr.io/nvidia/cuda:12.6.3-cudnn-devel-ubuntu24.04
ARG RUNTIME_IMAGE=nvcr.io/nvidia/cuda:12.6.3-runtime-ubuntu24.04
ARG PYTORCH_CUDA=cu126
ARG COMFY_REF=master
ARG COMFY_AIMDO_REF=v0.2.12
ARG COMFY_COMMIT=

# ==================================================================
# Stage 1: Builder (PyTorch wheels + ComfyUI deps)
# ==================================================================
FROM ${BUILDER_IMAGE} AS builder

ARG DEBIAN_FRONTEND=noninteractive
ARG PYTORCH_CUDA
ARG COMFY_REF
ARG COMFY_COMMIT
ARG COMFY_CACHEBUST=0

ENV VENV=/opt/venv \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TORCH_CUDA_ARCH_LIST=12.1

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl \
      git \
      python3 python3-venv \
      python3-dev build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    python3 -m venv ${VENV} \
 && ${VENV}/bin/python -m ensurepip --upgrade \
 && ${VENV}/bin/python -m pip install -U pip setuptools wheel setuptools-scm \
 && ${VENV}/bin/python -m pip install -U GitPython uv

RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    ${VENV}/bin/python -m pip install -U \
      --index-url https://download.pytorch.org/whl/${PYTORCH_CUDA} \
      torch torchvision torchaudio

RUN ${VENV}/bin/python - <<'PY2'
import torch
print('torch =', torch.__version__)
print('torch.version.cuda =', torch.version.cuda)
assert torch.version.cuda is not None
assert torch.backends.cuda.is_built()
PY2

RUN echo "COMFY_CACHEBUST=${COMFY_CACHEBUST}" \
 && echo "COMFY_REF=${COMFY_REF}" \
 && echo "COMFY_COMMIT=${COMFY_COMMIT}" \
 && git clone --filter=blob:none https://github.com/comfyanonymous/ComfyUI.git /opt/ComfyUI \
 && cd /opt/ComfyUI \
 && if [ -n "${COMFY_COMMIT}" ]; then \
      git fetch --depth 1 origin "${COMFY_COMMIT}" \
      && git checkout --detach "${COMFY_COMMIT}"; \
    else \
      git checkout "${COMFY_REF}"; \
    fi \
 && git rev-parse HEAD

RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    cd /opt/ComfyUI \
 && awk '!/^(torch|torchvision|torchaudio|comfy-aimdo)([<>= ].*)?$/ {print}' \
      requirements.txt > /tmp/requirements.no_torch.txt \
 && ${VENV}/bin/python -m pip install -U -r /tmp/requirements.no_torch.txt

RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    ${VENV}/bin/python -m pip install -U --no-binary :all: sageattention

# ==================================================================
# Stage 1-B: Build comfy-aimdo from source
# ==================================================================
FROM ${BUILDER_IMAGE} AS build_aimdo

ARG DEBIAN_FRONTEND=noninteractive
ARG COMFY_AIMDO_REF
ARG TARGETARCH

ENV VENV=/opt/venv \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TORCH_CUDA_ARCH_LIST=12.1

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      git \
      python3 python3-venv \
      python3-dev build-essential \
      file \
    && rm -rf /var/lib/apt/lists/*

RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    python3 -m venv ${VENV} \
 && ${VENV}/bin/python -m ensurepip --upgrade \
 && ${VENV}/bin/python -m pip install -U pip setuptools wheel setuptools-scm

RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    git clone https://github.com/Comfy-Org/comfy-aimdo.git /tmp/comfy-aimdo \
 && cd /tmp/comfy-aimdo \
 && git checkout "${COMFY_AIMDO_REF}" \
 && ARCH="${TARGETARCH:-$(uname -m)}" \
 && case "${ARCH}" in \
      amd64|x86_64) CUDA_TARGET='x86_64-linux' ;; \
      arm64|aarch64) CUDA_TARGET='sbsa-linux' ;; \
      *) echo "Unsupported arch: ${ARCH}" >&2; exit 1 ;; \
    esac \
 && echo "ARCH=${ARCH} CUDA_TARGET=${CUDA_TARGET}" \
 && test -d "/usr/local/cuda/targets/${CUDA_TARGET}/include" \
 && test -d "/usr/local/cuda/targets/${CUDA_TARGET}/lib/stubs" \
 && test -f "/usr/local/cuda/targets/${CUDA_TARGET}/lib/stubs/libcuda.so" \
 && gcc -shared -O2 -fPIC \
      -I./src \
      -I"/usr/local/cuda/targets/${CUDA_TARGET}/include" \
      src/*.c src-posix/*.c \
      -L"/usr/local/cuda/targets/${CUDA_TARGET}/lib/stubs" \
      -Wl,--no-as-needed -lcuda -ldl -lpthread \
      -o comfy_aimdo/aimdo.so \
 && test -f comfy_aimdo/aimdo.so \
 && file comfy_aimdo/aimdo.so \
 && (ldd comfy_aimdo/aimdo.so || true) \
 && (readelf -d comfy_aimdo/aimdo.so | grep NEEDED || true) \
 && ${VENV}/bin/python - <<'PY2'
import os
p = '/tmp/comfy-aimdo/comfy_aimdo/aimdo.so'
print('artifact test =', p)
assert os.path.exists(p), p
print('exists =', os.path.exists(p))
print('suffix =', os.path.splitext(p)[1])
print('build-time CUDA-dependent dlopen test skipped (libcuda.so.1 is runtime-provided)')
PY2

RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    cd /tmp/comfy-aimdo \
 && mkdir -p /tmp/wheels \
 && ${VENV}/bin/python -m pip wheel . --no-deps --no-build-isolation -w /tmp/wheels \
 && echo '=== build_aimdo wheel output ===' \
 && ls -l /tmp/wheels \
 && find /tmp/wheels -maxdepth 1 -type f -name 'comfy_aimdo-*.whl' -print \
 && test -n "$(find /tmp/wheels -maxdepth 1 -type f -name 'comfy_aimdo-*.whl' | head -n1)"

# ==================================================================
# Stage 2: Runtime (final image)
# ==================================================================
FROM ${RUNTIME_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      git \
      python3 \
      python3-venv \
      python3-dev \
      build-essential \
      libgl1 \
      libglib2.0-0 \
      ffmpeg \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/opt/venv/bin:/usr/local/nvidia/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
    VENV=/opt/venv \
    VIRTUAL_ENV=/opt/venv \
    PYTHONUNBUFFERED=1 \
    TRITON_CACHE_DIR=/opt/venv/.cache/triton \
    COMFY_LISTEN=0.0.0.0 \
    COMFY_PORT=8188 \
    COMFY_ARGS="--use-sage-attention" \
    PYTORCH_SDP_DISABLE_FLASH=0 \
    PYTORCH_SDP_DISABLE_MEM_EFFICIENT=0 \
    PYTORCH_SDP_DISABLE_MATH=0 \
    XFORMERS_FORCE_DISABLE_TRITON=1 \
    TORCHDYNAMO_DISABLE=1 \
    TORCHINDUCTOR_DISABLE=1 \
    CUDA_CACHE_PATH=/opt/venv/.cache/nv/ComputeCache \
    CUDA_CACHE_MAXSIZE=4294967296 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,video \
    CC=gcc \
    CXX=g++

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /opt/ComfyUI /opt/ComfyUI
COPY --from=build_aimdo /tmp/wheels /tmp/wheels-aimdo

RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    ${VENV}/bin/python -m pip uninstall -y comfy-aimdo || true \
 && echo '=== stage-2 copied comfy-aimdo wheels ===' \
 && ls -l /tmp/wheels-aimdo \
 && WHEEL="$(find /tmp/wheels-aimdo -maxdepth 1 -type f -name 'comfy_aimdo-*.whl' | head -n1)" \
 && test -n "${WHEEL}" \
 && echo "Using wheel: ${WHEEL}" \
 && ${VENV}/bin/python -m pip install --no-deps "${WHEEL}" \
 && rm -rf /tmp/wheels-aimdo \
 && ${VENV}/bin/python - <<'PY2'
import importlib.util
import os
import comfy_aimdo

spec = importlib.util.find_spec('comfy_aimdo')
print('comfy_aimdo.__file__ =', getattr(comfy_aimdo, '__file__', None))
print('spec.origin =', getattr(spec, 'origin', None))
pkg_dirs = list(getattr(comfy_aimdo, '__path__', []))
print('comfy_aimdo.__path__ =', pkg_dirs)
assert pkg_dirs, 'comfy_aimdo package directory not found'
so_path = os.path.join(pkg_dirs[0], 'aimdo.so')
print('aimdo.so =', so_path)
assert os.path.exists(so_path), so_path
print('runtime dlopen test skipped during image build (libcuda.so.1 is provided by NVIDIA runtime)')
PY2

WORKDIR /opt/ComfyUI
EXPOSE 8188

CMD ["/bin/sh", "-lc", "\
mkdir -p /opt/ComfyUI/.startup-state && \
/opt/venv/bin/python - <<'PY'\n\
import torch\n\
print('torch=', torch.__version__)\n\
print('cuda=', torch.version.cuda)\n\
print('cuda.is_available=', torch.cuda.is_available())\n\
if torch.cuda.is_available():\n\
  print('device=', torch.cuda.get_device_name(0))\n\
  print('capability=', torch.cuda.get_device_capability(0))\n\
PY\n\
echo '[startup] scanning custom_nodes requirements...'\n\
find /opt/ComfyUI/custom_nodes -type f -name requirements.txt 2>/dev/null | while read -r req; do\n\
  node_dir=\"$(dirname \"$req\")\"\n\
  node_name=\"$(basename \"$node_dir\")\"\n\
  filtered=\"/tmp/${node_name}.requirements.filtered.txt\"\n\
  hash_file=\"/opt/ComfyUI/.startup-state/${node_name}.requirements.sha256\"\n\
  current_hash=\"$(sha256sum \"$req\" | awk '{print $1}')\"\n\
  old_hash=''\n\
  if [ -f \"$hash_file\" ]; then\n\
    old_hash=\"$(cat \"$hash_file\" 2>/dev/null)\"\n\
  fi\n\
  echo \"[startup] found: $req\"\n\
  awk 'NF > 0 && $0 !~ /^[[:space:]]*#/ && $0 !~ /^(torch|torchvision|torchaudio)([<>=!~ ].*)?$/' \"$req\" > \"$filtered\"\n\
  if [ ! -s \"$filtered\" ]; then\n\
    echo \"[startup] no installable deps after filtering for $node_name\"\n\
    echo \"$current_hash\" > \"$hash_file\"\n\
    rm -f \"$filtered\"\n\
    continue\n\
  fi\n\
  if [ \"$current_hash\" = \"$old_hash\" ]; then\n\
    echo \"[startup] unchanged, skip install for $node_name\"\n\
    rm -f \"$filtered\"\n\
    continue\n\
  fi\n\
  echo \"[startup] changed, installing deps for $node_name\"\n\
  /opt/venv/bin/python -m pip install --no-cache-dir --disable-pip-version-check -U -r \"$filtered\" && echo \"$current_hash\" > \"$hash_file\"\n\
  rc=$?\n\
  rm -f \"$filtered\"\n\
  if [ $rc -ne 0 ]; then\n\
    echo \"[startup] pip install failed for $node_name\"\n\
    exit $rc\n\
  fi\n\
done\n\
/opt/venv/bin/python - <<'PY'\n\
import os, shlex\n\
listen = os.environ.get('COMFY_LISTEN', '0.0.0.0')\n\
port   = os.environ.get('COMFY_PORT', '8188')\n\
extra  = os.environ.get('COMFY_ARGS', '')\n\
extra_args = shlex.split(extra) if extra.strip() else []\n\
argv = ['/opt/venv/bin/python', 'main.py', '--listen', listen, '--port', str(port), *extra_args]\n\
print('[comfy] argv:', ' '.join(shlex.quote(a) for a in argv[2:]))\n\
os.chdir('/opt/ComfyUI')\n\
os.execv(argv[0], argv)\n\
PY\n\
"]
