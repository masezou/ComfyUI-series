# ------------------------------------------------------------------
# ComfyUI on NVIDIA CUDA base image (Docker Hub) (CU130 / BLACKWELL-OPTIMAL)
#
# Design goals:
# - Use NVIDIA CUDA image from Docker Hub (CUDA 13.0 / cu130)
# - Install PyTorch CUDA wheels explicitly (torch/torchvision/torchaudio)
# - Avoid optional CUDA extensions (xformers/flash-attn/triton builds)
# - Install ComfyUI and its dependencies
# - Build comfy-aimdo from source so aimdo.so is actually present
# - Keep git available in the runtime image for ComfyUI-Manager / GitPython
#
# Notes:
# - This is the "clean" baseline for Blackwell: CUDA 13.0 userland + torch cu130.
# - Intended as the reference implementation for stable operation and best performance.
# - Target GPUs (single image): Blackwell / Hopper / Ampere / Ada / Turing
#   (host driver must be new enough for the newest GPU in use).
#
# Important caveat:
# - This Dockerfile keeps the original Docker Hub PyTorch wheel approach.
# - On some ARM64 / GB10 combinations, upstream torch wheels may still warn that
#   capability 12.1 is beyond the wheel's declared support range.
# - The comfy-aimdo and git issues are fixed here, but GB10-specific torch wheel
#   behavior may still make the NGC-based image a better choice on GDX Spark.
# ------------------------------------------------------------------

ARG CUDA_VER=13.1.1
ARG UBUNTU_VER=24.04
ARG PYTORCH_CUDA=cu130
ARG COMFY_REF=master
ARG COMFY_COMMIT=
ARG COMFY_AIMDO_REF=v0.2.14

# ------------------------------------------------------------------
# Builder stage
# ------------------------------------------------------------------
FROM nvidia/cuda:${CUDA_VER}-cudnn-devel-ubuntu${UBUNTU_VER} AS builder

# ------------------------------------------------------------------
# Build arguments
# DEBIAN_FRONTEND: suppress interactive apt dialogs
# COMFY_REF: git branch or tag for ComfyUI
# PYTORCH_CUDA: PyTorch wheel channel selector (cu130)
# ------------------------------------------------------------------
ARG DEBIAN_FRONTEND=noninteractive
ARG PYTORCH_CUDA
ARG COMFY_REF
ARG COMFY_CACHEBUST=0

ENV VENV=/opt/venv \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TORCH_CUDA_ARCH_LIST=12.1
# NOTE: PIP_NO_CACHE_DIR/PIP_DISABLE_PIP_VERSION_CHECK apply to pip inside this stage.
#       This is mainly to avoid leaving pip caches in builder layers.

# ------------------------------------------------------------------
# Install minimal system dependencies
# - git: clone ComfyUI repository
# - ca-certificates: HTTPS support
# - curl: network utility
# - python3/python3-venv: create virtual environment
# - python3-dev/build-essential: build native Python extensions if needed
# ------------------------------------------------------------------
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl \
      git \
      python3 python3-venv \
      python3-dev build-essential \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------------
# Create Python virtual environment
# - Keep everything inside venv (base image has no torch anyway)
# - Upgrade pip/setuptools/wheel inside venv
# - Install ComfyUI-Manager deps (GitPython) and uv (optional but helps)
# ------------------------------------------------------------------
RUN python3 -m venv ${VENV} \
 && ${VENV}/bin/python -m ensurepip --upgrade \
 && ${VENV}/bin/python -m pip install -U pip setuptools wheel \
 && ${VENV}/bin/python -m pip install -U GitPython uv \
 && rm -rf /tmp/*

# ------------------------------------------------------------------
# Install PyTorch (CUDA wheels)
# - Use official PyTorch wheel index for the selected CUDA channel
# - This is the key difference between CU130/CU128/LEGACY variants.
# ------------------------------------------------------------------
RUN ${VENV}/bin/python -m pip install -U \
      --index-url https://download.pytorch.org/whl/${PYTORCH_CUDA} \
      torch torchvision torchaudio \
 && rm -rf /tmp/*

# ------------------------------------------------------------------
# Sanity check:
# Verify that torch is CUDA-enabled in this environment.
# This does NOT require GPU at build time.
# ------------------------------------------------------------------
RUN ${VENV}/bin/python - <<'PY'
import torch
print("torch =", torch.__version__)
print("torch.version.cuda =", torch.version.cuda)
assert torch.version.cuda is not None
assert torch.backends.cuda.is_built()
PY

# ------------------------------------------------------------------
# Clone ComfyUI and install dependencies
# - Remove torch/torchvision/torchaudio/comfy-aimdo from requirements.
#   We already install torch/vision/audio explicitly above.
#   comfy-aimdo will be built from source in a dedicated stage.
# ------------------------------------------------------------------
RUN echo "COMFY_CACHEBUST=${COMFY_CACHEBUST}" \
 && git clone --branch "${COMFY_REF}" --single-branch \
      https://github.com/comfyanonymous/ComfyUI.git /opt/ComfyUI \
 && rm -rf /opt/ComfyUI/.git

RUN awk '!/^(torch|torchvision|torchaudio|comfy-aimdo)([<>= ].*)?$/ {print}' \
      /opt/ComfyUI/requirements.txt > /tmp/requirements.no_torch.txt \
 && ${VENV}/bin/python -m pip install -U -r /tmp/requirements.no_torch.txt \
 && ${VENV}/bin/python -m pip install -U sageattention \
 && rm -rf /tmp/*

# ==================================================================
# Stage: build comfy-aimdo from source
# ==================================================================
# ------------------------------------------------------------------
# Why this stage exists:
# - Some environments end up with comfy-aimdo installed but without aimdo.so.
# - Building from source ensures the shared object exists in the wheel.
# - We support both x86_64 and arm64/aarch64 by switching CUDA target paths.
# ------------------------------------------------------------------
FROM nvidia/cuda:${CUDA_VER}-cudnn-devel-ubuntu${UBUNTU_VER} AS build_aimdo

ARG DEBIAN_FRONTEND=noninteractive
ARG COMFY_AIMDO_REF

ENV VENV=/opt/venv \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TORCH_CUDA_ARCH_LIST=12.1

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      git \
      python3 python3-venv \
      python3-dev build-essential \
      file \
    && rm -rf /var/lib/apt/lists/*

RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    python3 -m venv ${VENV} \
 && ${VENV}/bin/python -m ensurepip --upgrade \
 && ${VENV}/bin/python -m pip install -U pip setuptools wheel setuptools-scm \
 && rm -rf /tmp/*

RUN git clone https://github.com/Comfy-Org/comfy-aimdo.git /tmp/comfy-aimdo \
 && cd /tmp/comfy-aimdo \
 && git checkout "${COMFY_AIMDO_REF}" \
 && ARCH="$(uname -m)" \
 && case "${ARCH}" in \
      x86_64) CUDA_TARGET="x86_64-linux" ;; \
      aarch64|arm64) CUDA_TARGET="sbsa-linux" ;; \
      *) echo "Unsupported arch: ${ARCH}" >&2; exit 1 ;; \
    esac \
 && echo "ARCH=${ARCH} CUDA_TARGET=${CUDA_TARGET}" \
 && test -d "/usr/local/cuda/targets/${CUDA_TARGET}/include" \
 && test -d "/usr/local/cuda/targets/${CUDA_TARGET}/lib/stubs" \
 && test -f "/usr/local/cuda/targets/${CUDA_TARGET}/lib/stubs/libcuda.so" \
 && gcc -shared -o comfy_aimdo/aimdo.so -fPIC \
      -I"./src" \
      -I"/usr/local/cuda/targets/${CUDA_TARGET}/include" \
      -L"/usr/local/cuda/targets/${CUDA_TARGET}/lib/stubs" \
      -Wno-error \
      src/*.c src-posix/*.c -lcuda \
 && test -f comfy_aimdo/aimdo.so \
 && file comfy_aimdo/aimdo.so \
 && mkdir -p /tmp/wheels \
 && ${VENV}/bin/python -m pip wheel . \
      --no-deps --no-build-isolation \
      -w /tmp/wheels \
 && echo "=== build_aimdo wheel output ===" \
 && ls -l /tmp/wheels \
 && find /tmp/wheels -maxdepth 1 -type f -name 'comfy_aimdo-*.whl' -print \
 && test -n "$(find /tmp/wheels -maxdepth 1 -type f -name 'comfy_aimdo-*.whl' | head -n1)"

# =========================
# runtime (final image)
# =========================
FROM nvidia/cuda:${CUDA_VER}-cudnn-runtime-ubuntu${UBUNTU_VER}

ARG DEBIAN_FRONTEND=noninteractive

# Runtime deps only
# - git is intentionally included because ComfyUI-Manager / GitPython require it.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      git \
      python3 python3-venv \
      libgl1 libglib2.0-0 \
      ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Optional: Fix Triton cache location to reduce repeated JIT work across restarts.
# Defaults (override via compose env if needed)
ENV PATH="/opt/venv/bin:/usr/local/nvidia/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
    VENV=/opt/venv \
    VIRTUAL_ENV=/opt/venv \
    TORCH_CUDA_ARCH_LIST=12.1 \
    PYTHONUNBUFFERED=1 \
    TRITON_CACHE_DIR=/opt/venv/.cache/triton \
    COMFY_LISTEN=0.0.0.0 \
    COMFY_PORT=8188 \
    COMFY_ARGS="--use-sage-attention" \
    PYTORCH_SDP_DISABLE_FLASH=0 \
    PYTORCH_SDP_DISABLE_MEM_EFFICIENT=0 \
    PYTORCH_SDP_DISABLE_MATH=0 \
    XFORMERS_FORCE_DISABLE_TRITON=1 \
    TORCHDYNAMO_DISABLE=1 \
    TORCHINDUCTOR_DISABLE=1 \
    CUDA_CACHE_PATH=/opt/venv/.cache/nv/ComputeCache \
    CUDA_CACHE_MAXSIZE=4294967296 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,video

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /opt/ComfyUI /opt/ComfyUI
COPY --from=build_aimdo /tmp/wheels /tmp/wheels-aimdo
# NOTE: Copying /opt/venv brings torch/vision/audio in; this is intended.

# ------------------------------------------------------------------
# Install comfy-aimdo from source-built wheel and verify aimdo.so exists.
# ------------------------------------------------------------------
RUN ${VENV}/bin/python -m pip uninstall -y comfy-aimdo || true \
 && echo "=== stage-2 copied comfy-aimdo wheels ===" \
 && ls -l /tmp/wheels-aimdo \
 && WHEEL="$(find /tmp/wheels-aimdo -maxdepth 1 -type f -name 'comfy_aimdo-*.whl' | head -n1)" \
 && test -n "${WHEEL}" \
 && echo "Using wheel: ${WHEEL}" \
 && ${VENV}/bin/python -m pip install --no-deps "${WHEEL}" \
 && rm -rf /tmp/wheels-aimdo \
 && ${VENV}/bin/python - <<'PY'
import os
import importlib.util
import comfy_aimdo

spec = importlib.util.find_spec("comfy_aimdo")
print("comfy_aimdo.__file__ =", getattr(comfy_aimdo, "__file__", None))
print("comfy_aimdo.__path__ =", list(getattr(comfy_aimdo, "__path__", [])))
print("spec.origin =", getattr(spec, "origin", None))
print("spec.submodule_search_locations =", list(spec.submodule_search_locations or []))

pkg_dirs = list(getattr(comfy_aimdo, "__path__", []))
assert pkg_dirs, "comfy_aimdo package directory not found"

p = os.path.join(pkg_dirs[0], "aimdo.so")
print("aimdo.so exists =", os.path.exists(p), p)
assert os.path.exists(p), p
PY

# ------------------------------------------------------------------
# Runtime configuration
# ------------------------------------------------------------------
WORKDIR /opt/ComfyUI
EXPOSE 8188

# ------------------------------------------------------------------
# Container startup sequence
#
# 1. Print minimal CUDA/runtime diagnostics (informational only).
# 2. Print comfy-aimdo status.
# 3. Build argument vector for main.py using:
#      --listen <COMFY_LISTEN>
#      --port   <COMFY_PORT>
#      + parsed COMFY_ARGS
# 4. Use os.execv() to replace PID 1 with the Python process.
#    This ensures proper signal handling (SIGTERM/SIGINT).
# ------------------------------------------------------------------
CMD ["/bin/sh", "-lc", "\
mkdir -p /opt/ComfyUI/.startup-state && \
/opt/venv/bin/python - <<'PY'\n\
import torch\n\
print('torch=', torch.__version__)\n\
print('cuda=', torch.version.cuda)\n\
print('cuda.is_available=', torch.cuda.is_available())\n\
if torch.cuda.is_available():\n\
  print('device=', torch.cuda.get_device_name(0))\n\
  print('capability=', torch.cuda.get_device_capability(0))\n\
PY\n\
echo '[startup] scanning custom_nodes requirements...'\n\
find /opt/ComfyUI/custom_nodes -type f -name requirements.txt 2>/dev/null | while read -r req; do\n\
  node_dir=\"$(dirname \"$req\")\"\n\
  node_name=\"$(basename \"$node_dir\")\"\n\
  filtered=\"/tmp/${node_name}.requirements.filtered.txt\"\n\
  hash_file=\"/opt/ComfyUI/.startup-state/${node_name}.requirements.sha256\"\n\
  current_hash=\"$(sha256sum \"$req\" | awk '{print $1}')\"\n\
  old_hash=''\n\
  if [ -f \"$hash_file\" ]; then\n\
    old_hash=\"$(cat \"$hash_file\" 2>/dev/null)\"\n\
  fi\n\
  echo \"[startup] found: $req\"\n\
  awk 'NF > 0 && $0 !~ /^[[:space:]]*#/ && $0 !~ /^(torch|torchvision|torchaudio)([<>=!~ ].*)?$/' \"$req\" > \"$filtered\"\n\
  if [ ! -s \"$filtered\" ]; then\n\
    echo \"[startup] no installable deps after filtering for $node_name\"\n\
    echo \"$current_hash\" > \"$hash_file\"\n\
    rm -f \"$filtered\"\n\
    continue\n\
  fi\n\
  if [ \"$current_hash\" = \"$old_hash\" ]; then\n\
    echo \"[startup] unchanged, skip install for $node_name\"\n\
    rm -f \"$filtered\"\n\
    continue\n\
  fi\n\
  echo \"[startup] changed, installing deps for $node_name\"\n\
  /opt/venv/bin/python -m pip install --no-cache-dir --disable-pip-version-check -U -r \"$filtered\" && echo \"$current_hash\" > \"$hash_file\"\n\
  rc=$?\n\
  rm -f \"$filtered\"\n\
  if [ $rc -ne 0 ]; then\n\
    echo \"[startup] pip install failed for $node_name\"\n\
    exit $rc\n\
  fi\n\
done\n\
/opt/venv/bin/python - <<'PY'\n\
import os, shlex\n\
listen = os.environ.get('COMFY_LISTEN', '0.0.0.0')\n\
port   = os.environ.get('COMFY_PORT', '8188')\n\
extra  = os.environ.get('COMFY_ARGS', '')\n\
extra_args = shlex.split(extra) if extra.strip() else []\n\
argv = ['/opt/venv/bin/python', 'main.py', '--listen', listen, '--port', str(port), *extra_args]\n\
print('[comfy] argv:', ' '.join(shlex.quote(a) for a in argv[2:]))\n\
os.chdir('/opt/ComfyUI')\n\
os.execv(argv[0], argv)\n\
PY\n\
"]
