# syntax=docker/dockerfile:1
# ------------------------------------------------------------------
# ComfyUI on NVIDIA CUDA base image (NGC)
#
# Design goals:
# - Use NVIDIA NGC CUDA image
# - Install PyTorch CUDA wheels explicitly (torch/torchvision/torchaudio)
# - Avoid optional CUDA extensions (xformers/flash-attn/triton builds)
# - Install ComfyUI and its dependencies
# - Build comfy-aimdo from source so aimdo.so is actually present and loadable
# - Keep git available in the runtime image for ComfyUI-Manager / GitPython
#
# Notes:
# - This variant uses explicit NGC CUDA base images instead of Docker Hub nvidia/cuda.
# - Builder image : nvcr.io/nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04
# - Runtime image : nvcr.io/nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04
# - Default PyTorch wheel channel: cu128
# - For CUDA 12.9.x / 13.x, PyTorch wheel channels may not map 1:1 to the container CUDA
#   version. This file defaults to the selected PyTorch wheel channel intentionally.
# ------------------------------------------------------------------

ARG BUILDER_IMAGE=nvcr.io/nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04
ARG RUNTIME_IMAGE=nvcr.io/nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04
ARG PYTORCH_CUDA=cu128
ARG COMFY_REF=master
ARG COMFY_AIMDO_REF=v0.2.12

# ------------------------------------------------------------------
# Builder stage
# ------------------------------------------------------------------
FROM ${BUILDER_IMAGE} AS builder

ARG DEBIAN_FRONTEND=noninteractive
ARG PYTORCH_CUDA
ARG COMFY_REF
ARG COMFY_CACHEBUST=0

ENV VENV=/opt/venv     PIP_NO_CACHE_DIR=1     PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends       ca-certificates curl       git       python3 python3-venv       python3-dev build-essential     && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv ${VENV}  && ${VENV}/bin/python -m ensurepip --upgrade  && ${VENV}/bin/python -m pip install -U pip setuptools wheel  && ${VENV}/bin/python -m pip install -U GitPython uv  && rm -rf /root/.cache /tmp/*

RUN ${VENV}/bin/python -m pip install -U       --index-url https://download.pytorch.org/whl/${PYTORCH_CUDA}       torch torchvision torchaudio  && rm -rf /root/.cache /tmp/*

RUN ${VENV}/bin/python - <<'PY2'
import torch
print('torch =', torch.__version__)
print('torch.version.cuda =', torch.version.cuda)
assert torch.version.cuda is not None
assert torch.backends.cuda.is_built()
PY2

RUN echo "COMFY_CACHEBUST=${COMFY_CACHEBUST}"  && git clone --branch "${COMFY_REF}" --single-branch       https://github.com/comfyanonymous/ComfyUI.git /opt/ComfyUI  && rm -rf /opt/ComfyUI/.git

RUN awk '!/^(torch|torchvision|torchaudio|comfy-aimdo)([<>= ].*)?$/ {print}'       /opt/ComfyUI/requirements.txt > /tmp/requirements.no_torch.txt  && ${VENV}/bin/python -m pip install -U -r /tmp/requirements.no_torch.txt  && ${VENV}/bin/python -m pip install -U sageattention  && rm -rf /root/.cache /tmp/*

# ==================================================================
# Stage: build comfy-aimdo from source
# ==================================================================
FROM ${BUILDER_IMAGE} AS build_aimdo

ARG DEBIAN_FRONTEND=noninteractive
ARG COMFY_AIMDO_REF
ARG TARGETARCH

ENV VENV=/opt/venv     PIP_NO_CACHE_DIR=1     PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends       ca-certificates       git       python3 python3-venv       python3-dev build-essential       file     && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv ${VENV}  && ${VENV}/bin/python -m ensurepip --upgrade  && ${VENV}/bin/python -m pip install -U pip setuptools wheel setuptools-scm  && rm -rf /root/.cache /tmp/*

RUN git clone https://github.com/Comfy-Org/comfy-aimdo.git /tmp/comfy-aimdo  && cd /tmp/comfy-aimdo  && git checkout "${COMFY_AIMDO_REF}"  && ARCH="${TARGETARCH:-$(uname -m)}"  && case "${ARCH}" in       amd64|x86_64) CUDA_TARGET='x86_64-linux' ;;       arm64|aarch64) CUDA_TARGET='sbsa-linux' ;;       *) echo "Unsupported arch: ${ARCH}" >&2; exit 1 ;;     esac  && echo "ARCH=${ARCH} CUDA_TARGET=${CUDA_TARGET}"  && test -d "/usr/local/cuda/targets/${CUDA_TARGET}/include"  && test -d "/usr/local/cuda/targets/${CUDA_TARGET}/lib/stubs"  && test -f "/usr/local/cuda/targets/${CUDA_TARGET}/lib/stubs/libcuda.so"  && gcc -shared -O2 -fPIC       -I./src       -I"/usr/local/cuda/targets/${CUDA_TARGET}/include"       src/*.c src-posix/*.c       -L"/usr/local/cuda/targets/${CUDA_TARGET}/lib/stubs"       -Wl,--no-as-needed -lcuda -ldl -lpthread       -o comfy_aimdo/aimdo.so  && test -f comfy_aimdo/aimdo.so  && file comfy_aimdo/aimdo.so  && (ldd comfy_aimdo/aimdo.so || true)  && (readelf -d comfy_aimdo/aimdo.so | grep NEEDED || true)  && ${VENV}/bin/python - <<'PY2'
import importlib.util
import os
p = '/tmp/comfy-aimdo/comfy_aimdo/aimdo.so'
print('artifact test =', p)
assert os.path.exists(p), p
print('exists =', os.path.exists(p))
print('suffix =', os.path.splitext(p)[1])
print('build-time CUDA-dependent dlopen test skipped (libcuda.so.1 is runtime-provided)')
PY2

RUN cd /tmp/comfy-aimdo  && mkdir -p /tmp/wheels  && ${VENV}/bin/python -m pip wheel . --no-deps --no-build-isolation -w /tmp/wheels  && echo '=== build_aimdo wheel output ==='  && ls -l /tmp/wheels  && find /tmp/wheels -maxdepth 1 -type f -name 'comfy_aimdo-*.whl' -print  && test -n "$(find /tmp/wheels -maxdepth 1 -type f -name 'comfy_aimdo-*.whl' | head -n1)"

# =========================
# runtime (final image)
# =========================
FROM ${RUNTIME_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      git \
      python3 \
      python3-venv \
      python3-dev \
      build-essential \
      libgl1 \
      libglib2.0-0 \
      ffmpeg \
    && rm -rf /var/lib/apt/lists/*

ENV VENV=/opt/venv \
    PATH="/opt/venv/bin:/usr/local/nvidia/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
    VIRTUAL_ENV=/opt/venv \
    PYTHONUNBUFFERED=1 \
    TRITON_CACHE_DIR=/opt/venv/.cache/triton \
    COMFY_LISTEN=0.0.0.0 \
    COMFY_PORT=8188 \
    COMFY_ARGS="" \
    CC=gcc \
    CXX=g++

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /opt/ComfyUI /opt/ComfyUI
COPY --from=build_aimdo /tmp/wheels /tmp/wheels-aimdo

RUN ${VENV}/bin/python -m pip uninstall -y comfy-aimdo || true  && echo '=== stage-2 copied comfy-aimdo wheels ==='  && ls -l /tmp/wheels-aimdo  && WHEEL="$(find /tmp/wheels-aimdo -maxdepth 1 -type f -name 'comfy_aimdo-*.whl' | head -n1)"  && test -n "${WHEEL}"  && echo "Using wheel: ${WHEEL}"  && ${VENV}/bin/python -m pip install --no-deps "${WHEEL}"  && rm -rf /tmp/wheels-aimdo  && ${VENV}/bin/python - <<'PY2'
import importlib.util
import os
import comfy_aimdo

spec = importlib.util.find_spec('comfy_aimdo')
print('comfy_aimdo.__file__ =', getattr(comfy_aimdo, '__file__', None))
print('spec.origin =', getattr(spec, 'origin', None))
pkg_dirs = list(getattr(comfy_aimdo, '__path__', []))
print('comfy_aimdo.__path__ =', pkg_dirs)
assert pkg_dirs, 'comfy_aimdo package directory not found'
so_path = os.path.join(pkg_dirs[0], 'aimdo.so')
print('aimdo.so =', so_path)
assert os.path.exists(so_path), so_path
print('runtime dlopen test skipped during image build (libcuda.so.1 is provided by NVIDIA runtime)')
PY2

WORKDIR /opt/ComfyUI
EXPOSE 8188

CMD ["/bin/sh", "-lc", "\
echo '[info] starting ComfyUI'; \
/opt/venv/bin/python -c 'import torch; print(\"torch=\", torch.__version__); print(\"cuda=\", torch.version.cuda); print(\"cuda.is_available=\", torch.cuda.is_available()); print(\"device=\", torch.cuda.get_device_name(0) if torch.cuda.is_available() else \"CPU\"); print(\"capability=\", torch.cuda.get_device_capability(0) if torch.cuda.is_available() else \"N/A\")'; \
/opt/venv/bin/python -c 'import importlib.util, os; import comfy_aimdo; spec=importlib.util.find_spec(\"comfy_aimdo\"); pkg_dirs=list(getattr(comfy_aimdo, \"__path__\", [])); so_path=os.path.join(pkg_dirs[0], \"aimdo.so\") if pkg_dirs else \"\"; print(\"comfy-aimdo=\", getattr(comfy_aimdo, \"__file__\", None)); print(\"comfy-aimdo.spec=\", getattr(spec, \"origin\", None)); print(\"comfy-aimdo.aimdo_so=\", so_path, os.path.exists(so_path))' || true; \
LISTEN=\"${COMFY_LISTEN:-0.0.0.0}\"; \
PORT=\"${COMFY_PORT:-8188}\"; \
EXTRA=\"${COMFY_ARGS}\"; \
echo \"[comfy] --listen ${LISTEN} --port ${PORT} ${EXTRA}\"; \
cd /opt/ComfyUI; \
exec /bin/sh -lc '/opt/venv/bin/python main.py --listen \"${COMFY_LISTEN:-0.0.0.0}\" --port \"${COMFY_PORT:-8188}\" ${COMFY_ARGS}' \
"]
