# syntax=docker/dockerfile:1.7
# ------------------------------------------------------------------
# ComfyUI CPU-only image (multi-arch) - size-optimized multi-stage
#
# Stage 1 (builder):
# - Install build tools and headers needed for compiling Python wheels if required
# - Create a venv and install:
#   - CPU-only PyTorch (torch/torchvision/torchaudio)
#   - ComfyUI dependencies (excluding torch*)
# - Clone ComfyUI source
#
# Stage 2 (runtime):
# - Minimal runtime packages only (no compilers, no git)
# - Copy venv and ComfyUI tree from builder
# - Keep the same safe-argv startup logic as your original Dockerfile
#
# Key size wins:
# - build-essential and git are NOT present in the final image
# - pip caches are disabled and temp files are removed
# - apt lists are cleaned in both stages
#
# Notes:
# - This is designed for linux/amd64 and linux/arm64 with docker buildx.
# - If a dependency needs compilation, it is compiled in builder and carried over via venv.
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# Stage 1: builder
# ------------------------------------------------------------------
FROM python:3.12-slim AS builder

# BuildKit-provided args (useful for debugging)
ARG TARGETPLATFORM
ARG TARGETARCH

# General build args
ARG DEBIAN_FRONTEND=noninteractive
ARG COMFY_REF=master
ARG COMFY_COMMIT=master

# Pin versions for reproducibility
ARG TORCH_VER=2.12.0
ARG TV_VER=0.27.0
ARG TA_VER=2.11.0

# Environment for predictable, smaller installs
ENV PIP_NO_CACHE_DIR=1
ENV VENV=/opt/venv
ENV PYTHONUNBUFFERED=1

# ------------------------------------------------------------------
# Builder deps
# - Includes compilers and git because we build wheels and clone repos here
# ------------------------------------------------------------------
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    echo "[build] (builder) TARGETPLATFORM=${TARGETPLATFORM} TARGETARCH=${TARGETARCH}" \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      git ca-certificates curl \
      python3-venv \
      ffmpeg \
      libgl1 libglib2.0-0 \
      git-lfs \
      build-essential \
    && git lfs install --system \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------------
# Create venv and install baseline tooling
# ------------------------------------------------------------------
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    python3 -m venv ${VENV} \
 && ${VENV}/bin/python -m pip install -U pip setuptools wheel \
 && ${VENV}/bin/python -m pip install -U GitPython uv \
 && rm -rf /tmp/pip-* /tmp/tmp*

# ------------------------------------------------------------------
# Install CPU-only PyTorch wheels
# ------------------------------------------------------------------
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    ${VENV}/bin/python -m pip install \
      --index-url https://download.pytorch.org/whl/cpu \
      torch==${TORCH_VER} torchvision==${TV_VER} torchaudio==${TA_VER} \
 && rm -rf /tmp/pip-* /tmp/tmp*

# ------------------------------------------------------------------
# Sanity check (CPU-only)
# ------------------------------------------------------------------
RUN ${VENV}/bin/python - <<'PY'
import platform, torch
print("platform =", platform.platform())
print("machine  =", platform.machine())
print("torch    =", torch.__version__)
print("cuda.is_available =", torch.cuda.is_available())
assert not torch.cuda.is_available()
PY

# ------------------------------------------------------------------
# Clone ComfyUI and install deps (excluding torch*)
# ------------------------------------------------------------------
ARG COMFY_CACHEBUST=0
RUN echo "COMFY_CACHEBUST=${COMFY_CACHEBUST}" \
 && echo "COMFY_REF=${COMFY_REF}" \
 && echo "COMFY_COMMIT=${COMFY_COMMIT}" \
 && git clone --filter=blob:none https://github.com/comfyanonymous/ComfyUI.git /opt/ComfyUI \
 && cd /opt/ComfyUI \
 && if [ -n "${COMFY_COMMIT}" ]; then \
      git fetch --depth 1 origin "${COMFY_COMMIT}" \
   && git checkout --detach "${COMFY_COMMIT}"; \
    else \
      git checkout "${COMFY_REF}"; \
    fi \
 && git rev-parse HEAD

RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    bash -lc 'cd /opt/ComfyUI && \
      awk '"'"'NF > 0 && \
      $0 !~ /^[[:space:]]*#/ && \
      $0 !~ /^(torch|torchvision|torchaudio)([<>=!~ ].*)?$/ && \
      tolower($0) !~ /(nvidia|cuda|cudnn|tensorrt|triton|vfx)/ \
      {print}'"'"' requirements.txt > /tmp/requirements.no_torch.txt \
      && if [ -s /tmp/requirements.no_torch.txt ]; then \
           /opt/venv/bin/python -m pip install -U -r /tmp/requirements.no_torch.txt; \
         else \
           echo "[build] no installable deps after filtering"; \
         fi' \
 && rm -f /tmp/requirements.no_torch.txt \
 && rm -rf /tmp/pip-* /tmp/tmp*

# ------------------------------------------------------------------
# (Optional) strip caches inside venv to reduce size further
# - Remove __pycache__ and .pyc files (safe but makes startup slightly slower on first import)
# ------------------------------------------------------------------
RUN find ${VENV} -type d -name "__pycache__" -prune -exec rm -rf {} + \
 && find ${VENV} -type f -name "*.pyc" -delete

# ------------------------------------------------------------------
# Stage 2: runtime
# ------------------------------------------------------------------
FROM --platform=$TARGETPLATFORM python:3.12-slim AS runtime

ARG TARGETPLATFORM
ARG TARGETARCH
ARG DEBIAN_FRONTEND=noninteractive

# Runtime env
ENV VENV=/opt/venv
ENV PIP_NO_CACHE_DIR=1
ENV PYTHONUNBUFFERED=1

# ------------------------------------------------------------------
# Runtime deps only (no git, no compilers)
# - ffmpeg/libgl1/libglib2.0-0 are kept for common ComfyUI workloads
# - ca-certificates for HTTPS downloads (custom nodes may fetch assets)
# ------------------------------------------------------------------
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    echo "[build] (runtime) TARGETPLATFORM=${TARGETPLATFORM} TARGETARCH=${TARGETARCH}" \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      git \
      ca-certificates \
      ffmpeg \
      libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------------
# Copy artifacts from builder
# - venv contains torch + python deps
# - /opt/ComfyUI contains source code
# ------------------------------------------------------------------
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /opt/ComfyUI /opt/ComfyUI

# ------------------------------------------------------------------
# Runtime config
# ------------------------------------------------------------------
WORKDIR /opt/ComfyUI
EXPOSE 8188

ENV PATH="/opt/venv/bin:${PATH}" \
    VIRTUAL_ENV=/opt/venv \
    PYTHONUNBUFFERED=1 \
    CUDA_VISIBLE_DEVICES="" \
    NVIDIA_VISIBLE_DEVICES="" \
    TRITON_CACHE_DIR=/opt/venv/.cache/triton \
    COMFY_LISTEN=0.0.0.0 \
    COMFY_PORT=8188 \
    COMFY_ARGS="" \
    PYTORCH_SDP_DISABLE_FLASH=0 \
    PYTORCH_SDP_DISABLE_MEM_EFFICIENT=0 \
    PYTORCH_SDP_DISABLE_MATH=0 \
    XFORMERS_FORCE_DISABLE_TRITON=1 \
    TORCHDYNAMO_DISABLE=1 \
    TORCHINDUCTOR_DISABLE=1

# ------------------------------------------------------------------
# Entrypoint / CMD
# - Print minimal runtime diagnostics (CPU-only torch status).
# - Build argv for main.py using COMFY_LISTEN/COMFY_PORT/COMFY_ARGS.
# - execv replaces PID 1 with Python for proper signal handling.
#
# Security note:
# - COMFY_ARGS is parsed by Python's shlex.split(), not evaluated by the shell.
# ------------------------------------------------------------------
CMD ["/bin/sh", "-lc", "\
mkdir -p /opt/ComfyUI/.startup-state && \
/opt/venv/bin/python - <<'PY'\n\
import torch\n\
print('torch=', torch.__version__)\n\
print('backend=CPU-only')\n\
print('cuda.is_available=', torch.cuda.is_available())\n\
PY\n\
echo '[startup] scanning custom_nodes requirements...'\n\
find /opt/ComfyUI/custom_nodes -type f -name requirements.txt 2>/dev/null | while read -r req; do\n\
  node_dir=\"$(dirname \"$req\")\"\n\
  node_name=\"$(basename \"$node_dir\")\"\n\
  filtered=\"/tmp/${node_name}.requirements.filtered.txt\"\n\
  hash_file=\"/opt/ComfyUI/.startup-state/${node_name}.requirements.sha256\"\n\
  current_hash=\"$(sha256sum \"$req\" | awk '{print $1}')\"\n\
  old_hash=''\n\
  if [ -f \"$hash_file\" ]; then\n\
    old_hash=\"$(cat \"$hash_file\" 2>/dev/null)\"\n\
  fi\n\
  echo \"[startup] found: $req\"\n\
  if echo \"$node_name\" | grep -qiE 'nvidia|cuda|cudnn|tensorrt|triton|vfx'; then\n\
    echo \"[startup] skip GPU-specific node: $node_name\"\n\
    echo \"$current_hash\" > \"$hash_file\"\n\
    continue\n\
  fi\n\
  awk 'NF > 0 && $0 !~ /^[[:space:]]*#/ && $0 !~ /^(torch|torchvision|torchaudio)([<>=!~ ].*)?$/ && tolower($0) !~ /(nvidia|cuda|cudnn|tensorrt|triton|vfx)/ {print}' \"$req\" > \"$filtered\"\n\
  if [ ! -s \"$filtered\" ]; then\n\
    echo \"[startup] no installable deps after filtering for $node_name\"\n\
    echo \"$current_hash\" > \"$hash_file\"\n\
    rm -f \"$filtered\"\n\
    continue\n\
  fi\n\
  if [ \"$current_hash\" = \"$old_hash\" ]; then\n\
    echo \"[startup] unchanged, skip install for $node_name\"\n\
    rm -f \"$filtered\"\n\
    continue\n\
  fi\n\
  echo \"[startup] changed, installing deps for $node_name\"\n\
  /opt/venv/bin/python -m pip install --no-cache-dir --disable-pip-version-check -U -r \"$filtered\" && echo \"$current_hash\" > \"$hash_file\"\n\
  rc=$?\n\
  rm -f \"$filtered\"\n\
  if [ $rc -ne 0 ]; then\n\
    echo \"[startup] pip install failed for $node_name\"\n\
    exit $rc\n\
  fi\n\
done\n\
/opt/venv/bin/python - <<'PY'\n\
import os, shlex\n\
listen = os.environ.get('COMFY_LISTEN', '0.0.0.0')\n\
port   = os.environ.get('COMFY_PORT', '8188')\n\
extra  = os.environ.get('COMFY_ARGS', '')\n\
extra_args = shlex.split(extra) if extra.strip() else []\n\
argv = ['/opt/venv/bin/python', 'main.py', '--listen', listen, '--port', str(port), '--cpu', *extra_args]\n\
print('[comfy] argv:', ' '.join(shlex.quote(a) for a in argv[2:]))\n\
os.chdir('/opt/ComfyUI')\n\
os.execv(argv[0], argv)\n\
PY\n\
"]
