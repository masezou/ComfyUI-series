# syntax=docker/dockerfile:1
# ------------------------------------------------------------------
# ComfyUI on Docker Hub PyTorch CUDA runtime (LEGACY / PRE-BLACKWELL)
#
# Design goals:
# - Use official PyTorch CUDA runtime image from Docker Hub (older CUDA userland)
# - Keep preinstalled CUDA-enabled torch from base image
# - Avoid reinstalling torch/torchvision/torchaudio
# - Install ComfyUI dependencies except torch-related packages
# - Use Python venv with system-site-packages to reuse base torch
#
# Notes:
# - This image is intentionally "pre-Blackwell" for comparison.
# - On Blackwell (sm_120), this stack is expected to fail at runtime due to missing kernels.
# - On older GPUs, it should run normally and is useful as a regression baseline.
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# Base Image
# Older CUDA runtime + cuDNN + prebuilt torch (CUDA enabled)
# ------------------------------------------------------------------
FROM pytorch/pytorch:2.11.0-cuda12.6-cudnn9-runtime

# ------------------------------------------------------------------
# Build arguments
# DEBIAN_FRONTEND: suppress interactive apt dialogs
# COMFY_REF: git branch or tag for ComfyUI
# ------------------------------------------------------------------
ARG DEBIAN_FRONTEND=noninteractive
ARG COMFY_REF=master

# ------------------------------------------------------------------
# Install minimal system dependencies
# - git: clone ComfyUI repository
# - ca-certificates: HTTPS support
# - curl: network utility
# - python3-venv/python3-full: create virtual environment
# Clean apt cache to reduce image size
# ------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
      git ca-certificates curl \
      python3-venv python3-full \
      build-essential pkg-config python3-dev \
      ffmpeg \
      libgl1 libglib2.0-0 \
      git-lfs \
    && git lfs install --system \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------------
# Sanity check:
# Verify that torch in the base image is CUDA-enabled.
# This does NOT require GPU at build time.
# It ensures:
# - torch.version.cuda is defined
# - CUDA backend is compiled in
# ------------------------------------------------------------------
RUN python3 - <<'PY'
import torch
print("torch =", torch.__version__)
print("torch.version.cuda =", torch.version.cuda)
assert torch.version.cuda is not None
assert torch.backends.cuda.is_built()
PY

# ------------------------------------------------------------------
# Create Python virtual environment
# --system-site-packages allows reuse of torch installed in base image
# Ensure pip exists, then upgrade pip/setuptools/wheel
# Install ComfyUI-Manager deps (GitPython) and uv (optional but helps)
# ------------------------------------------------------------------
ENV VENV=/opt/venv \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
RUN python3 -m venv --system-site-packages ${VENV} \
 && ${VENV}/bin/python -m ensurepip --upgrade \
 && ${VENV}/bin/python -m pip install -U pip setuptools wheel \
 && ${VENV}/bin/python -m pip install -U GitPython uv \
 && rm -rf /root/.cache /tmp/pip-* /tmp/tmp*

# ------------------------------------------------------------------
# Clone ComfyUI and install dependencies
#
# Steps:
# 1. Clone official repository
# 2. Checkout specified branch/tag
# 3. Remove torch/torchvision/torchaudio from requirements
#    (we rely on base image versions)
# 4. Install remaining dependencies into venv
# ------------------------------------------------------------------
ARG COMFY_CACHEBUST=0
RUN echo "COMFY_CACHEBUST=${COMFY_CACHEBUST}" \
 && git clone https://github.com/comfyanonymous/ComfyUI.git /opt/ComfyUI \
 && cd /opt/ComfyUI \
 && git checkout "${COMFY_REF}" \
 && awk '!/^(torch|torchvision|torchaudio)([<>= ].*)?$/ {print}' requirements.txt > /tmp/requirements.no_torch.txt \
 && ${VENV}/bin/python -m pip install -U -r /tmp/requirements.no_torch.txt \
 && ${VENV}/bin/python -m pip install -U sageattention \
 && rm -f /tmp/requirements.no_torch.txt \
 && rm -rf /root/.cache /tmp/pip-* /tmp/tmp*

# ------------------------------------------------------------------
# Runtime configuration
# ------------------------------------------------------------------
WORKDIR /opt/ComfyUI
EXPOSE 8188

ENV VENV=/opt/venv \
    PATH="/opt/venv/bin:${PATH}" \
    VIRTUAL_ENV=/opt/venv \
    PYTHONUNBUFFERED=1 \
    TRITON_CACHE_DIR=/opt/venv/.cache/triton \
    COMFY_LISTEN=0.0.0.0 \
    COMFY_PORT=8188 \
    COMFY_ARGS="" \
    PYTORCH_SDP_DISABLE_FLASH=0 \
    PYTORCH_SDP_DISABLE_MEM_EFFICIENT=0 \
    PYTORCH_SDP_DISABLE_MATH=0 \
    XFORMERS_FORCE_DISABLE_TRITON=1 \
    TORCHDYNAMO_DISABLE=1 \
    TORCHINDUCTOR_DISABLE=1 \
    CUDA_CACHE_PATH=/opt/venv/.cache/nv/ComputeCache \
    CUDA_CACHE_MAXSIZE=4294967296 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,video

# ------------------------------------------------------------------
# Container startup sequence
#
# 1. Print minimal CUDA/runtime diagnostics (informational only).
# 2. Build argument vector for main.py using:
#      --listen <COMFY_LISTEN>
#      --port   <COMFY_PORT>
#      + parsed COMFY_ARGS
# 3. Use os.execv() to replace PID 1 with the Python process.
#    This ensures proper signal handling (SIGTERM/SIGINT).
#
# Security note:
#   COMFY_ARGS is parsed using shlex.split() inside Python.
#   It is NOT evaluated by the shell, preventing command injection.
# ------------------------------------------------------------------
CMD ["/bin/sh", "-lc", "\
mkdir -p /opt/ComfyUI/.startup-state && \
/opt/venv/bin/python - <<'PY'\n\
import torch\n\
print('torch=', torch.__version__)\n\
print('cuda=', torch.version.cuda)\n\
print('cuda.is_available=', torch.cuda.is_available())\n\
if torch.cuda.is_available():\n\
  print('device=', torch.cuda.get_device_name(0))\n\
  print('capability=', torch.cuda.get_device_capability(0))\n\
PY\n\
echo '[startup] scanning custom_nodes requirements...'\n\
find /opt/ComfyUI/custom_nodes -type f -name requirements.txt 2>/dev/null | while read -r req; do\n\
  node_dir=\"$(dirname \"$req\")\"\n\
  node_name=\"$(basename \"$node_dir\")\"\n\
  filtered=\"/tmp/${node_name}.requirements.filtered.txt\"\n\
  hash_file=\"/opt/ComfyUI/.startup-state/${node_name}.requirements.sha256\"\n\
  current_hash=\"$(sha256sum \"$req\" | awk '{print $1}')\"\n\
  old_hash=''\n\
  if [ -f \"$hash_file\" ]; then\n\
    old_hash=\"$(cat \"$hash_file\" 2>/dev/null)\"\n\
  fi\n\
  echo \"[startup] found: $req\"\n\
  awk 'NF > 0 && $0 !~ /^[[:space:]]*#/ && $0 !~ /^(torch|torchvision|torchaudio)([<>=!~ ].*)?$/' \"$req\" > \"$filtered\"\n\
  if [ ! -s \"$filtered\" ]; then\n\
    echo \"[startup] no installable deps after filtering for $node_name\"\n\
    echo \"$current_hash\" > \"$hash_file\"\n\
    rm -f \"$filtered\"\n\
    continue\n\
  fi\n\
  if [ \"$current_hash\" = \"$old_hash\" ]; then\n\
    echo \"[startup] unchanged, skip install for $node_name\"\n\
    rm -f \"$filtered\"\n\
    continue\n\
  fi\n\
  echo \"[startup] changed, installing deps for $node_name\"\n\
  /opt/venv/bin/python -m pip install --no-cache-dir --disable-pip-version-check -U -r \"$filtered\" && echo \"$current_hash\" > \"$hash_file\"\n\
  rc=$?\n\
  rm -f \"$filtered\"\n\
  if [ $rc -ne 0 ]; then\n\
    echo \"[startup] pip install failed for $node_name\"\n\
    exit $rc\n\
  fi\n\
done\n\
/opt/venv/bin/python - <<'PY'\n\
import os, shlex\n\
listen = os.environ.get('COMFY_LISTEN', '0.0.0.0')\n\
port   = os.environ.get('COMFY_PORT', '8188')\n\
extra  = os.environ.get('COMFY_ARGS', '')\n\
extra_args = shlex.split(extra) if extra.strip() else []\n\
argv = ['/opt/venv/bin/python', 'main.py', '--listen', listen, '--port', str(port), *extra_args]\n\
print('[comfy] argv:', ' '.join(shlex.quote(a) for a in argv[2:]))\n\
os.chdir('/opt/ComfyUI')\n\
os.execv(argv[0], argv)\n\
PY\n\
"]
